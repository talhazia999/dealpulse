# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
CORS_ORIGINS=http://localhost:5173

# Try DealPulse on your own HubSpot deals: set CRM_PROVIDER=hubspot and a private app access token.
CRM_PROVIDER=sample
HUBSPOT_ACCESS_TOKEN=

# The public HubSpot app (OAuth install + deal card). From your app's Auth tab in HubSpot.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://api.dealpulse.example/hubspot/oauth/callback
PUBLIC_BASE_URL=https://api.dealpulse.example
DATABASE_PATH=dealpulse.db
